  "formats": {
    "data": "3 (format.meta; format 2 is upgraded in place on open, format 1 needs adb-migrate)",
    "row": "optional schema version (reserved field u32::MAX in bincode, \"schema_version\" in JSON); unversioned rows read as version 1",
    "wal": "new Catalog record (appended variant; earlier records unchanged)",
    "checkpoint": "3 (unchanged; the journal also publishes schema/registry.meta)",
    "statistics": "3 (adds schema_version; formats 1 and 2 still read)",
    "planWire": "4 (envelope carries schema_epoch; v3 refused)",
    "batch": "2 (unchanged)",
    "cdc": "row changes carry schema_version; schema and drop_table entries"
  }
